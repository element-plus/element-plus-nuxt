{
  "name": "@element-plus/nuxt",
  "version": "1.2.0",
  "description": "Element Plus module for Nuxt",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.20.0"
  },
  "keywords": [
    "element-plus",
    "nuxt"
  ],
  "homepage": "https://github.com/element-plus/element-plus-nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/element-plus/element-plus-nuxt.git"
  },
  "bugs": {
    "url": "https://github.com/element-plus/element-plus-nuxt/issues"
  },
  "scripts": {
    "build": "npm run dev:prepare && nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:start": "node playground/.output/server/index.mjs",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "lint": "eslint . --fix --ext .ts,.vue,.js",
    "lint:test": "eslint . --ext .ts,.vue,.js --max-warnings 0"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": ">=0.2.6",
    "element-plus": ">=2"
  },
  "dependencies": {
    "@nuxt/kit": "^4.7.0",
    "magic-string": "^0.30.21",
    "mlly": "^1.8.2",
    "unplugin": "^3.7.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@nuxt/devtools": "^4.2.1",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.7.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@types/node": "^25.9.12",
    "element-plus": "^2.14.8",
    "eslint": "^8.57.1",
    "nuxi": "^3.37.0",
    "nuxt": "^4.7.0",
    "sass": "^1.108.2",
    "typescript": "^5.9.3",
    "vite-plugin-inspect": "^12.1.0",
    "vue": "^3.5.46"
  }
}
